# ===================================================
# Book A Doctor Platform Environment Configuration
# ===================================================

# ---------------------------------------------------
# Backend Server Configuration
# ---------------------------------------------------
PORT=5000
JWT_SECRET=book_a_doctor_secret_jwt_key_2026

# MongoDB Connection String
# For Local MongoDB: mongodb://127.0.0.1:27017/book_a_doctor
# For Cloud MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/book_a_doctor?retryWrites=true&w=majority
# Leave empty to automatically fallback to In-Memory MongoDB Server with auto-seeded data.
MONGODB_URI=

# ---------------------------------------------------
# Frontend Client Configuration
# ---------------------------------------------------
# Development API URL: http://localhost:5000/api
# Production API URL: https://book-a-doctor-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api
